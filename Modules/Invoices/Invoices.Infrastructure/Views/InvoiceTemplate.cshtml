@using System.Globalization
@using Invoices.Domain.Dictionaries
@model Invoices.Domain.Entities.Invoice
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <style>
        @@page { size: A4; margin: 18mm; }
        * { box-sizing: border-box; }
        body { color: #172033; font: 14px/1.5 Arial, sans-serif; margin: 0; }
        header { border-bottom: 2px solid #243b64; margin-bottom: 28px; padding-bottom: 16px; }
        h1 { color: #243b64; font-size: 28px; margin: 0 0 6px; overflow-wrap: anywhere; }
        .muted { color: #64748b; font-size: 12px; }
        .parties { display: flex; gap: 40px; margin-bottom: 28px; }
        .party { flex: 1; min-width: 0; }
        .party h2 { color: #64748b; font-size: 11px; letter-spacing: .08em; margin: 0 0 5px; text-transform: uppercase; }
        .party p { margin: 0; overflow-wrap: anywhere; }
        table { border-collapse: collapse; width: 100%; }
        thead { display: table-header-group; }
        th { background: #f1f5f9; color: #334155; font-size: 11px; text-align: left; text-transform: uppercase; }
        th, td { border-bottom: 1px solid #dbe2ea; padding: 10px 8px; }
        tr { break-inside: avoid; }
        .amount { text-align: right; white-space: nowrap; }
        .status { color: #475569; white-space: nowrap; }
        tfoot td { border: 0; font-weight: bold; padding-top: 16px; }
        .total-label { text-align: right; }
    </style>
</head>
<body>
    <header>
        <h1>@Model.Title</h1>
        <div class="muted">Invoice @Model.Id.ToString("N")[..8].ToUpperInvariant() &middot; @Model.InsDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</div>
    </header>
    <section class="parties">
        <div class="party"><h2>From</h2><p>@(Model.Collector.Login ?? Model.Collector.Email)</p></div>
        <div class="party"><h2>Recipient</h2><p>@(Model.Recipient.Login ?? Model.Recipient.Email)</p></div>
    </section>
    <table>
        <thead><tr><th>Position</th><th class="amount">Amount</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var position in Model.Positions)
        {
            <tr>
                <td>@position.Title</td>
                <td class="amount">@position.Value.ToString("N2", CultureInfo.InvariantCulture)</td>
                <td class="status">@(position.Status == InvoiceStatus.Paid.Key ? "Paid" : "Unpaid")</td>
            </tr>
        }
        </tbody>
        <tfoot><tr><td colspan="2" class="total-label">Total</td><td class="amount">@Model.Positions.Sum(position => position.Value).ToString("N2", CultureInfo.InvariantCulture)</td></tr></tfoot>
    </table>
</body>
</html>
