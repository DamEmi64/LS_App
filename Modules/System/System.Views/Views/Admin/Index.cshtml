@{
    ViewData["Title"] = "Admin Token Authorization";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
</head>
<body>

    @Html.ActionLink("Go to Admin Panel", "Users", "Admin")

    <pre id="responseBox"></pre>

    <script>
        (function () {
            let userToken = "";

            // Prompt user on page load
            document.addEventListener("DOMContentLoaded", () => {
                userToken = prompt("Enter your token or auth header value:");
                if (!userToken) {
                    alert("No token entered. Requests will fail.");
                }

                document.cookie = "adminToken=" + userToken + "; path=/";
                window.location.href = 'Admin/Users';

                console.log("Custom fetch override enabled.");
            });

        })();
    </script>
</body>
</html>
