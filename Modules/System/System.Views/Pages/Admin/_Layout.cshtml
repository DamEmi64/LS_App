<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link rel="stylesheet" href="//cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css" />

    <style>
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                margin: 0;
                background: #f5f6fa;
                color: #2c3e50;
            }

            nav.menubar {
                background: #34495e;
                display: flex;
                padding: 12px 20px;
            }

                nav.menubar a {
                    color: #ecf0f1;
                    text-decoration: none;
                    margin-right: 25px;
                    font-weight: 600;
                    padding: 6px 10px;
                    border-radius: 4px;
                }

                    nav.menubar a.active,
                    nav.menubar a:hover {
                        background-color: #2980b9;
                    }

            main.content {
                max-width: 1100px;
                margin: 0 auto;
                padding: 30px 20px;
            }

            h2 {
                margin-bottom: 25px;
                font-weight: 700;
            }

            /* Modal shared */
            .modal-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background: rgba(0,0,0,0.45);
                justify-content: center;
                align-items: center;
                z-index: 999;
            }

            .modal {
                background: #fff;
                padding: 25px;
                border-radius: 10px;
                width: 700px;
                max-height: 90vh;
                overflow-y: auto;
                box-shadow: 0 5px 15px rgba(0,0,0,0.3);
                position: relative;
            }

            .modal-close {
                position: absolute;
                top: 12px;
                right: 15px;
                cursor: pointer;
                font-size: 18px;
            }

            pre {
                background: #f0f0f0;
                padding: 10px;
                border-radius: 6px;
                max-height: 300px;
                overflow: auto;
            }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- Navbar -->
    <nav class="menubar">
        <a href="/Admin/Users" class="@(ViewData["Active"] as string == "Users" ? "active" : "")">Users</a>
        <a href="/Admin/Roles" class="@(ViewData["Active"] as string == "Roles" ? "active" : "")">Roles</a>
        <a href="/Admin/Logs" class="@(ViewData["Active"] as string == "Logs" ? "active" : "")">Logs</a>
        <a href="/Admin/Dictionaries" class="@(ViewData["Active"] as string == "Dictionaries" ? "active" : "")">Dictionaries</a>
        <a href="/hangfire">Hangfire</a>
    </nav>

    <main class="content">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="//cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>