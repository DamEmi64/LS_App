@page
@using System.Views.Pages.Admin

@model IndexModel

@{
    ViewData["Title"] = "Admin Token Authorization";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            background-color: #f5f6fa;
            color: #2c3e50;
        }

        .modal-overlay {
            display: none; /* hidden by default */
            justify-content: center;
            align-items: center;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.45);
            z-index: 999;
        }

        .modal {
            background: #fff;
            padding: 25px;
            border-radius: 10px;
            width: 420px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            position: relative;
            display: flex;
            flex-direction: column;
        }

            .modal h3 {
                margin-top: 0;
                margin-bottom: 15px;
                font-size: 20px;
            }

        .modal-close {
            position: absolute;
            top: 12px;
            right: 15px;
            font-size: 20px;
            cursor: pointer;
            color: #aaa;
        }

            .modal-close:hover {
                color: #e74c3c;
            }

        .modal input {
            width: 100%;
            padding: 8px;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 4px;
            margin-bottom: 20px;
        }

        .modal button {
            background-color: #2980b9;
            color: white;
            border: none;
            padding: 9px 16px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            transition: background .2s;
        }

            .modal button:hover {
                background-color: #1c5980;
            }

        .modal .secondary {
            background-color: #bdc3c7;
            color: #2c3e50;
            margin-left: 10px;
        }

            .modal .secondary:hover {
                background-color: #95a5a6;
            }
    </style>
</head>
<body>

    <!-- Token Modal -->
    <div id="tokenModal" class="modal-overlay">
        <div class="modal">
            <span class="modal-close" onclick="closeModal()">×</span>
            <h3>Enter Admin Token</h3>
            <input type="text" id="adminTokenInput" placeholder="Paste your token here..." />
            <div style="text-align:right;">
                <button onclick="saveToken()">Submit</button>
                <button class="secondary" onclick="closeModal()">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return decodeURIComponent(parts.pop().split(';')[0]);
            return null;
        }

        function closeModal() {
            document.getElementById('tokenModal').style.display = 'none';
        }

        function saveToken() {
            const token = document.getElementById('adminTokenInput').value.trim();
            if (!token) {
                alert("Please enter a token!");
                return;
            }

            const expires = new Date();
            expires.setTime(expires.getTime() + 24 * 60 * 60 * 1000); // 1 day
            document.cookie = `adminToken=${encodeURIComponent(token)}; path=/; expires=${expires.toUTCString()};`;

            window.location.href = '/Admin/Users';
        }

        // On page load
        window.addEventListener('DOMContentLoaded', () => {
            const token = getCookie('adminToken');
            if (token) {
                // Token already set, go straight to Users page
                window.location.href = '/Admin/Users';
            } else {
                // Show modal to enter token
                document.getElementById('tokenModal').style.display = 'flex';
            }
        });
    </script>

</body>
</html>