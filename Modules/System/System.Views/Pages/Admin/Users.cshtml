@page
@using System.Views.Pages.Admin
@model UsersModel
@{
    ViewData["Title"] = "Users Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="//cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            background-color: #f5f6fa;
            color: #2c3e50;
        }

        nav.menubar {
            background: #34495e;
            display: flex;
            padding: 12px 20px;
        }

            nav.menubar a {
                color: #ecf0f1;
                text-decoration: none;
                margin-right: 25px;
                font-weight: 600;
                font-size: 15px;
                padding: 6px 12px;
                border-radius: 5px;
                transition: background .2s;
            }

                nav.menubar a:hover {
                    background-color: #2980b9;
                }

        main.content {
            max-width: 1100px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        table.dataTable thead th {
            background-color: #34495e;
            color: white;
            padding: 12px;
        }

        .table-danger {
            background-color: #f8d7da !important;
            color: #721c24 !important;
        }

        .btn-action {
            padding: 4px 8px;
            font-size: 13px;
            border: none;
            border-radius: 4px;
            margin: 0 2px;
            cursor: pointer;
        }

        .btn-edit {
            background: #3498db;
            color: white;
        }

            .btn-edit:hover {
                background: #1c5980;
            }

        .btn-delete {
            background: #e74c3c;
            color: white;
        }

            .btn-delete:hover {
                background: #c0392b;
            }

        .btn-pwd {
            background: #f39c12;
            color: white;
        }

            .btn-pwd:hover {
                background: #d35400;
            }

        .btn-new {
            background: #27ae60;
            color: white;
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            margin-bottom: 15px;
            cursor: pointer;
            font-weight: 600;
        }

            .btn-new:hover {
                background: #1e8449;
            }

        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.45);
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        .modal {
            background: #fff;
            padding: 25px;
            border-radius: 10px;
            width: 420px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            position: relative;
        }

            .modal h3 {
                margin-top: 0;
                margin-bottom: 15px;
                font-size: 20px;
            }

        .modal-close {
            position: absolute;
            top: 12px;
            right: 15px;
            font-size: 20px;
            cursor: pointer;
            color: #aaa;
        }

            .modal-close:hover {
                color: #e74c3c;
            }

        .modal form label {
            display: block;
            margin: 10px 0 5px;
            font-weight: 600;
        }

        .modal form input, .modal form select {
            width: 100%;
            padding: 8px;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .modal .actions {
            margin-top: 20px;
            text-align: right;
        }

        button {
            background-color: #2980b9;
            color: white;
            border: none;
            padding: 9px 16px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            transition: background .2s;
        }

            button.secondary {
                background-color: #bdc3c7;
                color: #2c3e50;
            }

                button.secondary:hover {
                    background-color: #95a5a6;
                }

        /* Toasts */
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 2000;
        }

        .toast {
            padding: 12px 18px;
            border-radius: 6px;
            margin-bottom: 10px;
            color: #fff;
            font-size: 14px;
            font-weight: 500;
            opacity: 0;
            transform: translateX(100%);
            animation: slideIn .5s forwards, fadeOut .5s forwards 4s;
        }

            .toast.success {
                background: #27ae60;
            }

            .toast.error {
                background: #e74c3c;
            }

        @@keyframes slideIn {
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes fadeOut {
            to {
                opacity: 0;
                transform: translateX(100%);
            }
        }
    </style>
</head>
<body>

    <nav class="menubar">
        <a href="/Admin/Users">Users</a>
        <a href="/Admin/Roles">Roles</a>
        <a href="/Admin/Logs" class="active">Logs</a>
        <a href="/hangfire">Hangfire</a>
    </nav>

    <main class="content">
        <h2>User List</h2>
        <button class="btn-new" onclick="openNewUser()">+ New User</button>
        <table id="usersTable" class="display">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>UserName</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Role</th>
                    <th>Locked</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </main>

    <!-- Add User Modal -->
    <div id="userModal" class="modal-overlay">
        <div class="modal">
            <span class="modal-close" onclick="closeModal('userModal')">&times;</span>
            <h3>Add User</h3>
            <form id="userForm">
                <label>Username:</label>
                <input name="login" id="login" type="text" required />
                <label>First Name:</label>
                <input name="firstName" id="firstName" type="text" />
                <label>Last Name:</label>
                <input name="lastName" id="lastName" type="text" />
                <label>Email:</label>
                <input name="email" type="email" required />
                <label>Password:</label>
                <input name="password" type="password" required />
                <label>Role:</label>
                <select name="role" required>
                    <option value="">-- Select Role --</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Name">@role.Name</option>
                    }
                </select>
                <div class="actions">
                    <button type="submit">Create</button>
                    <button type="button" class="secondary" onclick="closeModal('userModal')">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div id="editModal" class="modal-overlay">
        <div class="modal">
            <span class="modal-close" onclick="closeModal('editModal')">&times;</span>
            <h3>Edit User</h3>
            <form id="editForm">
                <label>First Name:</label>
                <input name="firstName" id="firstName" type="text" />
                <label>Last Name:</label>
                <input name="lastName" id="lastName" type="text" />
                <label>Email:</label>
                <input name="email" type="email" />
                <label><input name="locked" type="checkbox" /> Locked</label>
                <input name="id" type="hidden" />
                <label>Role:</label>
                <select name="role" required>
                    <option value="">-- Select Role --</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role.Name">@role.Name</option>
                    }
                </select>
                <div class="actions">
                    <button type="submit">Update</button>
                    <button type="button" class="secondary" onclick="closeModal('editModal')">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reset Password Modal -->
    <div id="pwdModal" class="modal-overlay">
        <div class="modal">
            <span class="modal-close" onclick="closeModal('pwdModal')">&times;</span>
            <h3>Reset Password</h3>
            <form id="pwdForm">
                <label>Password:</label>
                <input name="password" type="password" required />
                <label>Verify:</label>
                <input name="verify" type="password" required />
                <input name="id" type="hidden" />
                <div class="actions">
                    <button type="submit">Reset</button>
                    <button type="button" class="secondary" onclick="closeModal('pwdModal')">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal-overlay">
        <div class="modal">
            <span class="modal-close" onclick="closeModal('deleteModal')">&times;</span>
            <h3>Confirm Delete</h3>
            <p>Are you sure you want to delete this user?</p>
            <input type="hidden" id="deleteUserId" />
            <div class="actions">
                <button onclick="confirmDelete()">Delete</button>
                <button type="button" class="secondary" onclick="closeModal('deleteModal')">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Password Reset Confirmation Modal -->
    <div id="pwdConfirmModal" class="modal-overlay">
        <div class="modal">
            <span class="modal-close" onclick="closeModal('pwdConfirmModal')">&times;</span>
            <h3>Confirm Reset</h3>
            <p>Are you sure you want to reset this user’s password?</p>
            <input type="hidden" id="pwdUserId" />
            <div class="actions">
                <button onclick="openPwdForm()">Yes, Reset</button>
                <button type="button" class="secondary" onclick="closeModal('pwdConfirmModal')">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="//cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>

    <script>
        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        var loginChanged = false;

        function fillLogin(ev) {
            var lastName = $('#lastName').val().toLowerCase().trim();
            var firstName = $('#firstName').val().toLowerCase().trim();

            if (loginChanged) {
                return;
            }

            var login = '';
            if (firstName) login += firstName;
            if (lastName) login += '.' + lastName;
            $('#login').val(login);
        }

        $('#login').on('change', function() {loginChanged = true});
        $('#lastName').on('change',fillLogin);
        $('#firstName').on('change',fillLogin);

        function showToast(message, type = "success") {
            var toast = $('<div class="toast ' + type + '">' + message + '</div>');
            $('#toast-container').append(toast);
            setTimeout(() => { toast.remove(); }, 5000);
        }

        function openNewUser() {
            loginChanged = false;
            $('#userForm')[0].reset();
            openModal('userModal');
        }

        $(function () {
            var table = $('#usersTable').DataTable({
                ajax: {
                        url: 'UserList',   // your backend endpoint            // or 'GET' if your action supports GET
                         data: function (d) {
                             d.search = d.search.value;
                        }
                    },
                processing: true,
                serverSide: true,
                columns: [
                    { data: "id" },
                    { data: "email" },
                    { data: "userName" },
                    { data: "firstName" },
                    { data: "lastName" },
                    { data: "role"},
                    { data: "lockedOut", render: d => d ? "Yes" : "No" },
                    {
                        data: null,
                        orderable: false,
                        render: (data, type, row) => `
                            <button class="btn-action btn-edit" onclick="editUser('${row.id}')">Edit</button>
                            <button class="btn-action btn-delete" onclick="deleteUser('${row.id}')">Delete</button>
                            <button class="btn-action btn-pwd" onclick="resetPwd('${row.id}')">Password</button>
                        `
                    }
                ],
                createdRow: function (row, data) {
                    if (data.lockedOut) $(row).addClass('table-danger');
                }
            });

        // Form submits
        $('#userForm').submit(function (e) {
            e.preventDefault();
            $.ajax({
                url: 'CreateUser',
                type: 'POST',
                data: $(this).serialize(),
                success: () => {
                    closeModal('userModal');
                    table.draw();
                    showToast("User created successfully");
                },
                error: xhr => {
                    showToast(xhr.responseText || "Create failed", "error");
                }
            });
        });

        $('#editForm').submit(function (e) {
            e.preventDefault();
            $.ajax({
                url: 'UpdateUser',
                type: 'POST',
                data: $(this).serialize(),
                success: () => {
                    closeModal('editModal');
                    table.draw();
                    showToast("User updated successfully");
                },
                error: xhr => {
                    showToast(xhr.responseText || "Update failed", "error");
                }
            });
        });

        $('#pwdForm').submit(function (e) {
            e.preventDefault();
            $.ajax({
                url: 'ResetPassword',
                type: 'POST',
                data: $(this).serialize(),
                success: () => {
                    closeModal('pwdModal');
                    showToast("Password reset successfully");
                },
                error: xhr => {
                    showToast(xhr.responseText || "Password reset failed", "error");
                }
            });
        });

            // Inline actions
            window.editUser = function (id) {
                $.get('GetUser', { id }, function (data) {
                    $('#editForm')[0].reset();
                    $('#editForm input[name=email]').val(data.email);
                    $('#editForm input[name=firstName]').val(data.firstName);
                    $('#editForm input[name=lastName]').val(data.lastName);
                    $('#editForm input[name=locked]').prop('checked', data.lockedOut);
                    $('#editForm input[name=id]').val(data.id);
                    $('#editForm select[name=role]').val(data.role || "");
                    openModal('editModal');
                });
            };

            window.deleteUser = function (id) {
                $('#deleteUserId').val(id);
                openModal('deleteModal');
            };

            window.confirmDelete = function () {
                var id = $('#deleteUserId').val();
                $.ajax({ type: 'DELETE', url: 'admin/DeleteUser', data: { id } })
                    .done(() => { closeModal('deleteModal'); table.draw(); showToast("User deleted successfully"); })
                    .fail(xhr => { showToast(xhr.responseText || "Delete failed", "error"); });
            };

            window.resetPwd = function (id) {
                $('#pwdUserId').val(id);
                openModal('pwdConfirmModal');
            };

            window.openPwdForm = function () {
                var id = $('#pwdUserId').val();
                closeModal('pwdConfirmModal');
                $('#pwdForm')[0].reset();
                $('#pwdForm input[name=id]').val(id);
                openModal('pwdModal');
            };
        });
    </script>
</body>
</html>
