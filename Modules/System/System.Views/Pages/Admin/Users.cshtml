@page
@using System.Views.Pages.Admin
@model UsersModel

@{
    ViewData["Title"] = "Users Page";
    ViewData["Active"] = "Users";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

@section Styles {
<style>
    table.dataTable thead th {
        background-color: #34495e;
        color: white;
        padding: 12px;
    }

    .table-danger {
        background-color: #f8d7da !important;
        color: #721c24 !important;
    }

    .btn-action {
        padding: 4px 8px;
        font-size: 13px;
        border: none;
        border-radius: 4px;
        margin: 0 2px;
        cursor: pointer;
        color: white;
    }

    .btn-edit { background: #3498db; }
    .btn-edit:hover { background: #1c5980; }

    .btn-delete { background: #e74c3c; }
    .btn-delete:hover { background: #c0392b; }

    .btn-pwd { background: #f39c12; }
    .btn-pwd:hover { background: #d35400; }

    .btn-new {
        background: #27ae60;
        color: white;
        padding: 8px 14px;
        border-radius: 5px;
        margin-bottom: 15px;
        cursor: pointer;
        font-weight: 600;
        border: none;
    }

    .btn-new:hover { background: #1e8449; }

    #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 2000;
    }

    .toast {
        padding: 12px 18px;
        border-radius: 6px;
        margin-bottom: 10px;
        color: #fff;
        font-size: 14px;
    }

    .toast.success { background: #27ae60; }
    .toast.error { background: #e74c3c; }
</style>
}

<h2>User List</h2>

<button class="btn-new" onclick="openNewUser()">+ New User</button>

<table id="usersTable" class="display">
    <thead>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>UserName</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Role</th>
            <th>Locked</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>

<!-- Modals (unchanged) -->
<div id="userModal" class="modal-overlay">
    <div class="modal">
        <span class="modal-close" onclick="closeModal('userModal')">&times;</span>
        <h3>Add User</h3>
        <form id="userForm">
            <label>Username:</label>
            <input name="login" id="login" type="text" required />

            <label>First Name:</label>
            <input name="firstName" id="firstName" type="text" />

            <label>Last Name:</label>
            <input name="lastName" id="lastName" type="text" />

            <label>Email:</label>
            <input name="email" type="email" required />

            <label>Password:</label>
            <input name="password" type="password" required />

            <label>Role:</label>
            <select name="role" required>
                <option value="">-- Select Role --</option>
                @foreach (var role in Model.Roles)
                {
                    <option value="@role.Name">@role.Name</option>
                }
            </select>

            <div class="actions">
                <button type="submit">Create</button>
                <button type="button" class="secondary" onclick="closeModal('userModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- (keep Edit / Password / Delete modals exactly as you had them) -->

<div id="toast-container"></div>

@section Scripts {
<script>
    function openModal(id) { $('#' + id).css('display', 'flex'); }
    function closeModal(id) { $('#' + id).hide(); }

    function showToast(message, type = "success") {
        const toast = $(`<div class="toast ${type}">${message}</div>`);
        $('#toast-container').append(toast);
        setTimeout(() => toast.fadeOut(() => toast.remove()), 4000);
    }

    let loginChanged = false;

    function fillLogin() {
        if (loginChanged) return;

        const first = $('#firstName').val().toLowerCase().trim();
        const last = $('#lastName').val().toLowerCase().trim();

        $('#login').val(first && last ? `${first}.${last}` : first || last);
    }

    $(function () {

        $('#login').on('input', () => loginChanged = true);
        $('#firstName, #lastName').on('input', fillLogin);

        const table = $('#usersTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: 'UserList',
                data: d => d.search = d.search.value
            },
            columns: [
                { data: "id" },
                { data: "email" },
                { data: "userName" },
                { data: "firstName" },
                { data: "lastName" },
                { data: "role" },
                { data: "lockedOut", render: d => d ? "Yes" : "No" },
                {
                    data: null,
                    orderable: false,
                    render: row => `
                        <button class="btn-action btn-edit" onclick="editUser('${row.id}')">Edit</button>
                        <button class="btn-action btn-delete" onclick="deleteUser('${row.id}')">Delete</button>
                        <button class="btn-action btn-pwd" onclick="resetPwd('${row.id}')">Password</button>
                    `
                }
            ],
            createdRow: (row, data) => {
                if (data.lockedOut) $(row).addClass('table-danger');
            }
        });

        $('#userForm').submit(function (e) {
            e.preventDefault();

            $.post('CreateUser', $(this).serialize())
                .done(() => {
                    closeModal('userModal');
                    table.draw();
                    showToast("User created");
                })
                .fail(x => showToast(x.responseText || "Create failed", "error"));
        });

        $('#editForm').submit(function (e) {
            e.preventDefault();

            $.post('UpdateUser', $(this).serialize())
                .done(() => {
                    closeModal('editModal');
                    table.draw();
                    showToast("User updated");
                })
                .fail(x => showToast(x.responseText || "Update failed", "error"));
        });

        $('#pwdForm').submit(function (e) {
            e.preventDefault();

            $.post('ResetPassword', $(this).serialize())
                .done(() => {
                    closeModal('pwdModal');
                    showToast("Password reset");
                })
                .fail(x => showToast(x.responseText || "Reset failed", "error"));
        });

        window.openNewUser = function () {
            loginChanged = false;
            $('#userForm')[0].reset();
            openModal('userModal');
        };

        window.editUser = function (id) {
            $.get('GetUser', { id }, function (d) {
                $('#editForm input[name=id]').val(d.id);
                $('#editForm input[name=email]').val(d.email);
                $('#editForm input[name=firstName]').val(d.firstName);
                $('#editForm input[name=lastName]').val(d.lastName);
                $('#editForm input[name=locked]').prop('checked', d.lockedOut);
                $('#editForm select[name=role]').val(d.role || "");
                openModal('editModal');
            });
        };

        window.deleteUser = function (id) {
            $('#deleteUserId').val(id);
            openModal('deleteModal');
        };

        window.confirmDelete = function () {
            const id = $('#deleteUserId').val();

            $.ajax({
                type: 'DELETE',
                url: 'DeleteUser',
                data: { id }
            })
            .done(() => {
                closeModal('deleteModal');
                table.draw();
                showToast("Deleted");
            })
            .fail(() => showToast("Delete failed", "error"));
        };

        window.resetPwd = function (id) {
            $('#pwdUserId').val(id);
            openModal('pwdConfirmModal');
        };

        window.openPwdForm = function () {
            const id = $('#pwdUserId').val();
            closeModal('pwdConfirmModal');
            $('#pwdForm')[0].reset();
            $('#pwdForm input[name=id]').val(id);
            openModal('pwdModal');
        };
    });
</script>
}