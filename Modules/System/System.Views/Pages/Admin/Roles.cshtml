@page
@using System.Views.Pages.Admin
@model RolesModel

@{
    ViewData["Title"] = "Roles Page";
    ViewData["Active"] = "Roles";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        background-color: #f5f6fa;
        color: #2c3e50;
    }

    nav.menubar {
        background: #34495e;
        display: flex;
        padding: 12px 20px;
    }

        nav.menubar a {
            color: #ecf0f1;
            text-decoration: none;
            margin-right: 25px;
            font-weight: 600;
            font-size: 15px;
            padding: 6px 12px;
            border-radius: 5px;
            transition: background .2s;
        }

            nav.menubar a:hover {
                background-color: #2980b9;
            }

    main.content {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    table.dataTable thead th {
        background-color: #34495e;
        color: white;
        padding: 12px;
    }

    .table-danger {
        background-color: #f8d7da !important;
        color: #721c24 !important;
    }

    .btn-action {
        padding: 4px 8px;
        font-size: 13px;
        border: none;
        border-radius: 4px;
        margin: 0 2px;
        cursor: pointer;
    }

    .btn-edit {
        background: #3498db;
        color: white;
    }

        .btn-edit:hover {
            background: #1c5980;
        }

    .btn-delete {
        background: #e74c3c;
        color: white;
    }

        .btn-delete:hover {
            background: #c0392b;
        }

    .btn-pwd {
        background: #f39c12;
        color: white;
    }

        .btn-pwd:hover {
            background: #d35400;
        }

    .btn-new {
        background: #27ae60;
        color: white;
        padding: 8px 14px;
        border: none;
        border-radius: 5px;
        margin-bottom: 15px;
        cursor: pointer;
        font-weight: 600;
    }

        .btn-new:hover {
            background: #1e8449;
        }

    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.45);
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .modal {
        background: #fff;
        padding: 25px;
        border-radius: 10px;
        width: 420px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        position: relative;
    }

        .modal h3 {
            margin-top: 0;
            margin-bottom: 15px;
            font-size: 20px;
        }

    .modal-close {
        position: absolute;
        top: 12px;
        right: 15px;
        font-size: 20px;
        cursor: pointer;
        color: #aaa;
    }

        .modal-close:hover {
            color: #e74c3c;
        }

    .modal form label {
        display: block;
        margin: 10px 0 5px;
        font-weight: 600;
    }

    .modal form input, .modal form select {
        width: 100%;
        padding: 8px;
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .modal .actions {
        margin-top: 20px;
        text-align: right;
    }

    button {
        background-color: #2980b9;
        color: white;
        border: none;
        padding: 9px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 600;
        transition: background .2s;
    }

        button.secondary {
            background-color: #bdc3c7;
            color: #2c3e50;
        }

            button.secondary:hover {
                background-color: #95a5a6;
            }

    /* Toasts */
    #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 2000;
    }

    .toast {
        padding: 12px 18px;
        border-radius: 6px;
        margin-bottom: 10px;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        opacity: 0;
        transform: translateX(100%);
        animation: slideIn .5s forwards, fadeOut .5s forwards 4s;
    }

        .toast.success {
            background: #27ae60;
        }

        .toast.error {
            background: #e74c3c;
        }

    @@keyframes slideIn {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes fadeOut {
        to {
            opacity: 0;
            transform: translateX(100%);
        }
    }

    .tab {
        padding: 8px 16px;
        cursor: pointer;
        font-weight: 600;
        color: #2980b9;
        border: 1px solid transparent;
        border-bottom: none;
        user-select: none;
    }

        .tab.active {
            border: 1px solid #2980b9;
            border-bottom: 2px solid white;
            background: white;
            color: #34495e;
            border-radius: 8px 8px 0 0;
        }

    .tab-content {
        border: 1px solid #2980b9;
        padding: 15px;
        border-radius: 0 8px 8px 8px;
        background: white;
    }

    .claims-checkboxes {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

        .claims-checkboxes label {
            background: #ecf0f1;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }
</style>

<h2>Role List</h2>

<button class="btn-new" onclick="openModal('roleModal')">+ New Role</button>

<table id="rolesTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>

<div id="toast"></div>

<!-- Add Role Modal -->
<div id="roleModal" class="modal-overlay">
    <div class="modal">
        <span class="modal-close" onclick="closeModal('roleModal')">&times;</span>
        <h3>Add Role</h3>

        <div class="tabs">
            <span class="tab active" data-tab="roleAddTab">Role</span>
            <span class="tab" data-tab="claimsAddTab">Claims</span>
        </div>

        <div id="roleAddTab" class="tab-content">
            <form id="roleForm">
                <label>Name:</label>
                <input name="name" type="text" required />

                <div style="text-align:right; margin-top:15px;">
                    <button type="submit">Create</button>
                    <button type="button" class="secondary" onclick="closeModal('roleModal')">Cancel</button>
                </div>
            </form>
        </div>

        <div id="claimsAddTab" class="tab-content" style="display:none;">
            <h4>Select Claims</h4>
            <div id="claimsCheckboxesAdd" class="claims-checkboxes">
                @if (Model.Claims is not null)
                {
                    foreach (var cl in Model.Claims)
                    {
                        var id = $"add_{cl.Key}";
                        <label for="@id">
                            <input type="checkbox" id="@id" value="@cl.Key" />
                            @cl.Value
                        </label>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div id="editModal" class="modal-overlay">
    <div class="modal">
        <span class="modal-close" onclick="closeModal('editModal')">&times;</span>
        <h3>Edit Role</h3>

        <div class="tabs">
            <span class="tab active" data-tab="roleTab">Role</span>
            <span class="tab" data-tab="claimsTab">Claims</span>
        </div>

        <div id="roleTab" class="tab-content">
            <form id="editForm">
                <input type="hidden" name="id" />
                <label>Name:</label>
                <input name="name" type="text" required />

                <div style="text-align:right; margin-top:15px;">
                    <button type="submit">Update</button>
                    <button type="button" class="secondary" onclick="closeModal('editModal')">Cancel</button>
                </div>
            </form>
        </div>

        <div id="claimsTab" class="tab-content" style="display:none;">
            <h4>Edit Claims</h4>
            <div id="claimsCheckboxesEdit" class="claims-checkboxes">
                @if (Model.Claims is not null)
                {
                    foreach (var cl in Model.Claims)
                    {
                        var id = $"edit_{cl.Key}";
                        <label for="@id">
                            <input type="checkbox" id="@id" value="@cl.Key" />
                            @cl.Value
                        </label>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) { $('#' + id).css('display', 'flex'); }
        function closeModal(id) { $('#' + id).hide(); }

        function showToast(msg, error = false) {
            var t = $('#toast');
            t.text(msg).toggleClass('error', error).fadeIn();
            setTimeout(() => t.fadeOut(), 3000);
        }

        function collectClaims(containerId, form) {
            $(`#${containerId} input:checked`).each(function (i, cb) {
                $(form).append(`<input type="hidden" name="claims[${i}].Key" value="${cb.value}" />`);
            });
        }

        $(function () {
            var table = $('#rolesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: 'RoleList',
                    data: d => d.search = d.search.value
                },
                columns: [
                    { data: 'id' },
                    { data: 'name' },
                    {
                        data: null,
                        render: d => (d.name === 'admin' || d.name === 'user')
                            ? ''
                            : `<button class="btn-small editBtn">Edit</button>
                               <button class="btn-small btn-danger deleteBtn">Delete</button>`
                    }
                ]
            });

            $(document).on('click', '.tab', function () {
                var tab = $(this).data('tab');
                $(this).siblings().removeClass('active');
                $(this).addClass('active');
                $(this).closest('.modal').find('.tab-content').hide();
                $('#' + tab).show();
            });

            $('#roleForm').submit(function (e) {
                e.preventDefault();
                collectClaims("claimsCheckboxesAdd", this);

                $.post('/Admin/CreateRole', $(this).serialize())
                    .done(() => {
                        closeModal('roleModal');
                        table.ajax.reload();
                        showToast("Role created");
                    })
                    .fail(x => showToast(x.responseText || "Error", true))
                    .always(() => $(this).find('input[type=hidden]').remove());
            });

            $('#rolesTable').on('click', '.editBtn', function () {
                var data = table.row($(this).closest('tr')).data();

                $.get('GetRole', { id: data.id }, function (res) {
                    $('#editForm input[name=id]').val(res.id);
                    $('#editForm input[name=name]').val(res.name);

                    $('#claimsCheckboxesEdit input').prop('checked', false);
                    res.claims?.forEach(c => {
                        $(`#edit_${c.key}`).prop('checked', true);
                    });

                    openModal('editModal');
                });
            });

            $('#editForm').submit(function (e) {
                e.preventDefault();
                collectClaims("claimsCheckboxesEdit", this);

                $.post('/Admin/UpdateRole', $(this).serialize())
                    .done(() => {
                        closeModal('editModal');
                        table.ajax.reload();
                        showToast("Updated");
                    })
                    .fail(x => showToast(x.responseText || "Error", true))
                    .always(() => $(this).find('input[type=hidden]').remove());
            });

            $('#rolesTable').on('click', '.deleteBtn', function () {
                var data = table.row($(this).closest('tr')).data();
                if (!confirm("Delete role?")) return;

                $.ajax({
                    type: 'DELETE',
                    url: '/Admin/DeleteRole',
                    data: { id: data.id }
                })
                .done(() => {
                    table.ajax.reload();
                    showToast("Deleted");
                })
                .fail(() => showToast("Delete failed", true));
            });
        });
    </script>
}