@page
@using System.Views.Pages.Admin
@model RolesModel

@{
    ViewData["Title"] = "Roles Page";
    ViewData["Active"] = "Roles";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

@section Styles {
    <style>
        table.dataTable thead th {
            background-color: #34495e;
            color: white;
            padding: 12px;
        }

        .btn-small {
            padding: 4px 8px;
            font-size: 13px;
            border: none;
            border-radius: 4px;
            margin: 0 2px;
            cursor: pointer;
            background: #3498db;
            color: white;
        }

            .btn-small:hover {
                background: #1c5980;
            }

        .btn-danger {
            background: #e74c3c;
        }

            .btn-danger:hover {
                background: #c0392b;
            }

        .btn-new {
            background: #27ae60;
            color: white;
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            margin-bottom: 15px;
            cursor: pointer;
            font-weight: 600;
        }

            .btn-new:hover {
                background: #1e8449;
            }

        /* Tabs */
        .tab {
            padding: 8px 16px;
            cursor: pointer;
            font-weight: 600;
            color: #2980b9;
            border-bottom: 2px solid transparent;
        }

            .tab.active {
                border-bottom: 2px solid #2980b9;
                color: #34495e;
            }

        .tab-content {
            margin-top: 10px;
        }

        .claims-checkboxes {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

            .claims-checkboxes label {
                background: #ecf0f1;
                padding: 6px 10px;
                border-radius: 6px;
                cursor: pointer;
                font-size: 14px;
            }

        /* Toast */
        #toast {
            position: fixed;
            top: 20px;
            right: 20px;
            background: #27ae60;
            color: white;
            padding: 12px 18px;
            border-radius: 6px;
            display: none;
            z-index: 2000;
        }

            #toast.error {
                background: #e74c3c;
            }
    </style>
}

<h2>Role List</h2>

<button class="btn-new" onclick="openModal('roleModal')">+ New Role</button>

<table id="rolesTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
</table>

<div id="toast"></div>

<!-- Add Role Modal -->
<div id="roleModal" class="modal-overlay">
    <div class="modal">
        <span class="modal-close" onclick="closeModal('roleModal')">&times;</span>
        <h3>Add Role</h3>

        <div class="tabs">
            <span class="tab active" data-tab="roleAddTab">Role</span>
            <span class="tab" data-tab="claimsAddTab">Claims</span>
        </div>

        <div id="roleAddTab" class="tab-content">
            <form id="roleForm">
                <label>Name:</label>
                <input name="name" type="text" required />

                <div style="text-align:right; margin-top:15px;">
                    <button type="submit">Create</button>
                    <button type="button" class="secondary" onclick="closeModal('roleModal')">Cancel</button>
                </div>
            </form>
        </div>

        <div id="claimsAddTab" class="tab-content" style="display:none;">
            <h4>Select Claims</h4>
            <div id="claimsCheckboxesAdd" class="claims-checkboxes">
                @if (Model.Claims is not null)
                {
                    foreach (var cl in Model.Claims)
                    {
                        var id = $"add_{cl.Key}";
                        <label for="@id">
                            <input type="checkbox" id="@id" value="@cl.Key" />
                            @cl.Value
                        </label>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div id="editModal" class="modal-overlay">
    <div class="modal">
        <span class="modal-close" onclick="closeModal('editModal')">&times;</span>
        <h3>Edit Role</h3>

        <div class="tabs">
            <span class="tab active" data-tab="roleTab">Role</span>
            <span class="tab" data-tab="claimsTab">Claims</span>
        </div>

        <div id="roleTab" class="tab-content">
            <form id="editForm">
                <input type="hidden" name="id" />
                <label>Name:</label>
                <input name="name" type="text" required />

                <div style="text-align:right; margin-top:15px;">
                    <button type="submit">Update</button>
                    <button type="button" class="secondary" onclick="closeModal('editModal')">Cancel</button>
                </div>
            </form>
        </div>

        <div id="claimsTab" class="tab-content" style="display:none;">
            <h4>Edit Claims</h4>
            <div id="claimsCheckboxesEdit" class="claims-checkboxes">
                @if (Model.Claims is not null)
                {
                    foreach (var cl in Model.Claims)
                    {
                        var id = $"edit_{cl.Key}";
                        <label for="@id">
                            <input type="checkbox" id="@id" value="@cl.Key" />
                            @cl.Value
                        </label>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) { $('#' + id).css('display', 'flex'); }
        function closeModal(id) { $('#' + id).hide(); }

        function showToast(msg, error = false) {
            var t = $('#toast');
            t.text(msg).toggleClass('error', error).fadeIn();
            setTimeout(() => t.fadeOut(), 3000);
        }

        function collectClaims(containerId, form) {
            $(`#${containerId} input:checked`).each(function (i, cb) {
                $(form).append(`<input type="hidden" name="claims[${i}].Key" value="${cb.value}" />`);
            });
        }

        $(function () {
            var table = $('#rolesTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: 'RoleList',
                    data: d => d.search = d.search.value
                },
                columns: [
                    { data: 'id' },
                    { data: 'name' },
                    {
                        data: null,
                        render: d => (d.name === 'admin' || d.name === 'user')
                            ? ''
                            : `<button class="btn-small editBtn">Edit</button>
                               <button class="btn-small btn-danger deleteBtn">Delete</button>`
                    }
                ]
            });

            $(document).on('click', '.tab', function () {
                var tab = $(this).data('tab');
                $(this).siblings().removeClass('active');
                $(this).addClass('active');
                $(this).closest('.modal').find('.tab-content').hide();
                $('#' + tab).show();
            });

            $('#roleForm').submit(function (e) {
                e.preventDefault();
                collectClaims("claimsCheckboxesAdd", this);

                $.post('/Admin/CreateRole', $(this).serialize())
                    .done(() => {
                        closeModal('roleModal');
                        table.ajax.reload();
                        showToast("Role created");
                    })
                    .fail(x => showToast(x.responseText || "Error", true))
                    .always(() => $(this).find('input[type=hidden]').remove());
            });

            $('#rolesTable').on('click', '.editBtn', function () {
                var data = table.row($(this).closest('tr')).data();

                $.get('GetRole', { id: data.id }, function (res) {
                    $('#editForm input[name=id]').val(res.id);
                    $('#editForm input[name=name]').val(res.name);

                    $('#claimsCheckboxesEdit input').prop('checked', false);
                    res.claims?.forEach(c => {
                        $(`#edit_${c.key}`).prop('checked', true);
                    });

                    openModal('editModal');
                });
            });

            $('#editForm').submit(function (e) {
                e.preventDefault();
                collectClaims("claimsCheckboxesEdit", this);

                $.post('/Admin/UpdateRole', $(this).serialize())
                    .done(() => {
                        closeModal('editModal');
                        table.ajax.reload();
                        showToast("Updated");
                    })
                    .fail(x => showToast(x.responseText || "Error", true))
                    .always(() => $(this).find('input[type=hidden]').remove());
            });

            $('#rolesTable').on('click', '.deleteBtn', function () {
                var data = table.row($(this).closest('tr')).data();
                if (!confirm("Delete role?")) return;

                $.ajax({
                    type: 'DELETE',
                    url: '/Admin/DeleteRole',
                    data: { id: data.id }
                })
                .done(() => {
                    table.ajax.reload();
                    showToast("Deleted");
                })
                .fail(() => showToast("Delete failed", true));
            });
        });
    </script>
}