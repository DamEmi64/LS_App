@page
@model LogsModel

@{
    ViewData["Title"] = "Logs Page";
    ViewData["Active"] = "Logs";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

@section Styles {
    <style>
        table.dataTable thead th {
            background: #34495e;
            color: white;
        }

        .filter-bar {
            margin-bottom: 15px;
        }

        select {
            padding: 6px;
            border-radius: 4px;
            border: 1px solid #ccc;
        }

        table td {
            max-width: 250px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .log-modal {
            width: 900px;
            max-width: 95%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 24px;
            border-radius: 12px;
            background: #fff;
            position: relative;
        }

        .modal-close {
            position: absolute;
            top: 12px;
            right: 16px;
            border: none;
            background: transparent;
            font-size: 28px;
            cursor: pointer;
        }

        .log-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

        .log-badges {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
        }

        .badge {
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            color: white;
            text-transform: uppercase;
        }

        .blue-badge {
            background: #2563eb;
        }

        .green-badge {
            background: #16a34a;
        }

        .red-badge {
            background: #dc2626;
        }

        .yellow-badge {
            background: #ca8a04;
        }

        .log-meta {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .meta-item {
            display: flex;
            flex-direction: column;
        }

            .meta-item label {
                font-size: 12px;
                font-weight: 700;
                color: #666;
                margin-bottom: 4px;
                text-transform: uppercase;
            }

        .log-section {
            margin-top: 20px;
        }

            .log-section pre {
                background: #34495e;
                color: #f9fafb;
                padding: 14px;
                border-radius: 8px;
                overflow-x: auto;
                white-space: pre-wrap;
            }
    </style>
}

<h2>Application Logs</h2>

<div class="filter-bar">
    <label><strong>Filter by Level:</strong></label>
    <select id="levelFilter">
        <option value="">All</option>
        <option value="Error">Error</option>
        <option value="Warning">Warning</option>
        <option value="Info">Info</option>
        <option value="Debug">Debug</option>
    </select>
    <select id="methodFilter">
        <option value="">All</option>
        <option value="Get">GET</option>
        <option value="Post">POST</option>
        <option value="Put">PUT</option>
        <option value="Delete">DELETE</option>
    </select>
</div>

<table id="logsTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>Level</th>
            <th>Method</th>
            <th>Uri</th>
            <th>Time</th>
            <th>Message</th>
            <th>Exception</th>
            <th>User</th>
        </tr>
    </thead>
</table>

<!-- Modal -->
<div id="logModal" class="modal-overlay">
    <div class="modal log-modal">

        <button class="modal-close" onclick="closeModal('logModal')">
            &times;
        </button>
        <div class="log-header">
            <h2>Log Details</h2>
        </div>
        <div class="log-badges">
            <span id="logLevel" class="badge badge-level"></span>
            <span id="logMethod" class="badge"></span>
        </div>
        <div class="log-meta">
            <div class="meta-item">
                <label>Id</label>
                <span id="logId"></span>
            </div>
            <div class="meta-item">
                <label>User</label>
                <span id="logUser"></span>
            </div>
            <div class="meta-item">
                <label>Time</label>
                <span id="logTime"></span>
            </div>
            <div class="meta-item">
                <label>Request</label>
                <span id="logUri"></span>
            </div>
        </div>
        <div class="log-section">
            <h4>Message</h4>
            <pre id="logMessage"></pre>
        </div>
        <div class="log-section">
            <h4>Exception</h4>
            <pre id="logException"></pre>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        $(function () {
            var table = $('#logsTable').DataTable({
                processing: true,
                serverSide: true,
                searching:true,
                ordering: false,
                ajax: {
                    url: '/Admin/LogsData',
                    type: 'GET',
                    data: function (d) {
                        d.level = $('#levelFilter').val();
                        d.method = $('#methodFilter').val();
                    }
                },
                columns: [
                    { data: 'level' },
                    { data: "httpMethod" },
                    { data: "httpUri" },
                    { data: 'timeStamp' },
                    {
                        data: 'message',
                        render: d => d && d.length > 80 ? d.substring(0, 80) + "..." : d
                    },
                    {
                        data: 'exception',
                        render: d => d && d.length > 80 ? d.substring(0, 80) + "..." : d
                    },
                    { data: "user"}
                ],
                order: [[2, "desc"]],
                pageLength: 25
            });

            $('#levelFilter').change(() => table.ajax.reload());
            $('#methodFilter').change(() => table.ajax.reload());
            $('#logsTable tbody').on('click', 'tr', function () {
                var data = table.row(this).data();
                $('#logId').text(data.id);
                $('#logLevel').text(data.level);
                $('#logTime').text(data.timeStamp);
                $('#logMessage').text(data.message || "");
                $('#logException').text(data.exception || "");
                $('#logUser').text(data.user || "");
                $('#logUri').text(data.httpUri || "");
                setMethodBadge(data.httpMethod);
                setLevelBadge(data.level);
                openModal('logModal');
            });
        });

        function setMethodBadge(method) {
            const el = document.getElementById('logMethod');

            el.className = 'badge';

            switch (method?.toUpperCase()) {
                case 'GET':
                    el.classList.add('blue-badge');
                    break;

                case 'POST':
                    el.classList.add('green-badge');
                    break;

                case 'DELETE':
                    el.classList.add('red-badge');
                    break;

                case 'PUT':
                    el.classList.add('yellow-badge');
                    break;
            }

            el.innerText = method;
        }

        function setLevelBadge(level) {
            const el = document.getElementById('logLevel');

            el.className = 'badge';

            switch (level?.toUpperCase()) {
                case 'WARNING':
                    el.classList.add('yellow-badge');
                    break;

                case 'ERROR':
                    el.classList.add('red-badge');
                    break;
                default:
                    el.classList.add('blue-badge');
                    break;
            }

            el.innerText = level;
        }
    </script>
}