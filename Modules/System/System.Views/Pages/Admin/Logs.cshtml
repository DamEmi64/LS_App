@page
@model LogsModel

@{
    ViewData["Title"] = "Logs Page";
    ViewData["Active"] = "Logs";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

@section Styles {
    <style>
        table.dataTable thead th {
            background: #34495e;
            color: white;
        }

        .filter-bar {
            margin-bottom: 15px;
        }

        select {
            padding: 6px;
            border-radius: 4px;
            border: 1px solid #ccc;
        }

        table td {
            max-width: 250px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    </style>
}

<h2>Application Logs</h2>

<div class="filter-bar">
    <label><strong>Filter by Level:</strong></label>
    <select id="levelFilter">
        <option value="">All</option>
        <option value="Error">Error</option>
        <option value="Warning">Warning</option>
        <option value="Info">Info</option>
        <option value="Debug">Debug</option>
    </select>
    <select id="methodFilter">
        <option value="">All</option>
        <option value="Get">GET</option>
        <option value="Post">POST</option>
        <option value="Put">PUT</option>
        <option value="Delete">DELETE</option>
    </select>
</div>

<table id="logsTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>Level</th>
            <th>Method</th>
            <th>Uri</th>
            <th>Time</th>
            <th>Message</th>
            <th>Exception</th>
            <th>User</th>
        </tr>
    </thead>
</table>

<!-- Modal -->
<div id="logModal" class="modal-overlay">
    <div class="modal">
        <span class="modal-close" onclick="closeModal('logModal')">&times;</span>
        <h3>Log Details</h3>
        <div><strong>Id:</strong> <span id="logId"></span></div>
        <div><strong>Level:</strong> <span id="logLevel"></span></div>
        <div><strong>Time:</strong> <span id="logTime"></span></div>
        <h4>Message</h4>
        <pre id="logMessage"></pre>
        <h4>Exception</h4>
        <pre id="logException"></pre>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        $(function () {
            var table = $('#logsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/Admin/LogsData',
                    type: 'GET',
                    data: function (d) {
                        d.level = $('#levelFilter').val();
                        d.method = $('#methodFilter').val();
                    }
                },
                columns: [
                    { data: 'level' },
                    { data: "httpMethod" },
                    { data: "httpUri" },
                    { data: 'timeStamp' },
                    {
                        data: 'message',
                        render: d => d && d.length > 80 ? d.substring(0, 80) + "..." : d
                    },
                    {
                        data: 'exception',
                        render: d => d && d.length > 80 ? d.substring(0, 80) + "..." : d
                    },
                    { data: "user"}
                ],
                order: [[2, "desc"]],
                pageLength: 25
            });

            $('#levelFilter').change(() => table.ajax.reload());
            $('#methodFilter').change(() => table.ajax.reload());
            $('#logsTable tbody').on('click', 'tr', function () {
                var data = table.row(this).data();
                $('#logId').text(data.id);
                $('#logLevel').text(data.level);
                $('#logTime').text(data.timeStamp);
                $('#logMessage').text(data.message || "");
                $('#logException').text(data.exception || "");
                openModal('logModal');
            });
        });
    </script>
}