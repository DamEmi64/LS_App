@using RPG.Infrastructure.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model StoryModelExtended

@{
    Layout = null;
}

<html lang="en">
<head>
    <title>@Model.Title</title>

    <style>
        :root {
            --primary: #007bff;
            --secondary: #f8f9fa;
            --accent: #e2e6ea;
            --text: #333;
            --bg: #fff;
            --shadow: rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f2f5;
            margin: 0;
            padding: 0;
        }

        .rpg-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem;
            gap: 1.5rem;
        }

        .rpg-container-item {
            background: var(--bg);
            border-radius: 12px;
            box-shadow: 0 4px 12px var(--shadow);
            width: 100%;
            max-width: 900px;
            padding: 1rem 1.5rem;
        }

        .story h1 {
            color: var(--primary);
            text-align: center;
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .story p {
            font-size: 1.1rem;
            color: var(--text);
            line-height: 1.6;
        }

        .collapsible {
            background-color: var(--primary);
            color: white;
            cursor: pointer;
            padding: 14px 18px;
            width: 100%;
            border: none;
            border-radius: 6px;
            text-align: left;
            font-size: 16px;
            transition: background-color 0.3s ease;
            margin: 0.5rem 0;
        }

            .collapsible:hover,
            .collapsible.active {
                background-color: #0056b3;
            }

            .collapsible:after {
                content: '\002B';
                float: right;
                font-weight: bold;
                transition: transform 0.2s ease;
            }

            .collapsible.active:after {
                content: '\2212';
            }

        .content {
            max-height: 0;
            overflow: hidden;
            background-color: var(--bg);
            transition: max-height 0.3s ease;
            padding: 0 1rem;
            border-left: 3px solid var(--accent);
            margin-bottom: 1rem;
        }

            .content.open {
                padding-top: 1rem;
            }

        .tab {
            display: flex;
            flex-wrap: wrap;
            background-color: var(--accent);
            border-radius: 6px;
            overflow: hidden;
            margin-top: 1rem;
        }

            .tab button {
                flex: 1;
                background-color: transparent;
                border: none;
                padding: 10px 14px;
                cursor: pointer;
                transition: background-color 0.2s ease;
                font-size: 16px;
                color: #000;
            }

                .tab button:hover {
                    background-color: #d1d1d1;
                }

                .tab button.active {
                    background-color: #ccc;
                    font-weight: bold;
                }

        .tabcontent {
            display: none;
            padding: 1rem 0;
            animation: fadeEffect 0.5s ease-in-out;
        }

            .tabcontent.active {
                display: block;
            }

        .summary-item {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
        }

            .summary-item p {
                flex: 1;
                font-size: 1rem;
            }

            .summary-item img {
                max-width: 200px;
                border-radius: 8px;
                box-shadow: 0 2px 6px var(--shadow);
            }

        @@keyframes fadeEffect {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .background {
            width: 100vw;
            height: 100vh;
            overflow-y: scroll;
            background-size: cover;
            background-image: url('data:image;base64,');
        }
    </style>
</head>
<body>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <div class="background">
        <section></section>
        <div class="rpg-container">
            <div class="rpg-container-item">
                <div class="story">
                    <h1>@Model.Title</h1>
                    <br>
                    <p>@Model.Description</p>
                </div>
            </div>
            @foreach (var chapter in Model.Chapters)
            {
                <div class="rpg-container-item">
                    <button class="collapsible">@chapter.Title</button>
                    <div class="content">
                        <p>@chapter.Description</p>
                        <div>
                            <button class="collapsible">Bohaterowie</button>
                            <div class="content">
                                <div class="tab">
                                    @foreach (var hero in chapter.Heroes)
                                    {
                                        <button class="tablinks" onclick="openTab(event, '@hero.Id')">@hero.FirstName @hero.LastName</button>
                                    }
                                </div>
                                @foreach (var hero in chapter.Heroes)
                                {
                                    <div id="@hero.Id" class="tabcontent">
                                        <div class="summary-item">
                                            @if(hero.Player is not null) {
                                                <p>Gracz: @hero.Player</p>
                                            }
                                            <p>@hero.Description</p>
                                            <img src="@hero.Image">
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div>
                            <button class="collapsible">Miejsca</button>
                            <div class="content">
                                <div class="tab">
                                    @foreach (var place in chapter.Places)
                                    {
                                        <button class="tablinks" onclick="openTab(event, '@place.Id')">@place.Title</button>
                                    }
                                </div>
                                @foreach (var place in chapter.Places)
                                {
                                    <div id="@place.Id" class="tabcontent">
                                        <div class="summary-item">
                                            <p>@place.Description</p>
                                            <img src="@place.Image">
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script>
        var coll = document.getElementsByClassName("collapsible");
        var i;

        for (i = 0; i < coll.length; i++) {
          coll[i].addEventListener("click", function() {
            this.classList.toggle("active");
            var content = this.nextElementSibling;
            if (content.style.maxHeight){
              content.style.maxHeight = null;
            } else {
              content.style.maxHeight = window.innerHeight;
              content.style.height = 'auto';
            }
          });
        }
    </script>

    <script>
        function openTab(evt, cityName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(cityName).style.display = "block";
        evt.currentTarget.className += " active";
        }
    </script>

</body>
</html>