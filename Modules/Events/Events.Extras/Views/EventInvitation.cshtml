@using Events.Extras.Resources
@model EventSendingData

<style>
    body {
        margin: 0;
        padding: 0;
        background: #f4f6f9;
        font-family: Arial, sans-serif;
        color: #333;
    }

    .container {
        max-width: 700px;
        margin: 40px auto;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }

    .header {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        padding: 40px 30px;
        text-align: center;
    }

        .header h1 {
            margin: 0;
            font-size: 32px;
        }

    .content {
        padding: 30px;
    }

    .event-image {
        width: 100%;
        border-radius: 12px;
        margin-bottom: 24px;
    }

    .greeting {
        font-size: 18px;
        margin-bottom: 18px;
    }

    .event-title {
        color: #4f46e5;
        font-size: 28px;
        margin-bottom: 16px;
    }

    .description {
        line-height: 1.7;
        font-size: 16px;
        margin-bottom: 30px;
    }

    .button-wrapper {
        text-align: center;
    }

    .button {
        display: inline-block;
        padding: 14px 28px;
        background: #4f46e5;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        transition: 0.3s;
    }

        .button:hover {
            background: #4338ca;
        }

    .footer {
        text-align: center;
        padding: 20px;
        background: #fafafa;
        color: #777;
        font-size: 14px;
    }
</style>
<div class="container">

    <div class="header">
        <h1>Zaproszenie na wydarzenie</h1>
    </div>

    <div class="content">

        <p class="greeting">
            Cześć @Model.User.Login,
        </p>
        <p class="description">
            Zapraszamy cię na następujące wydarzenie:
        </p>


        @if(Model.Image is not null)
        {
            <img class="event-image"
                 src="@Model.Image"
                 alt="Wydarzenie @Model.Event.Title" />
        }

        <h2 class="event-title">Wydarzenie @Model.Event.Title</h2>

        <p class="description">
            @Model.Event.Description
        </p>

        <div class="button-wrapper">
            <a class="button"
                   href=""
                   target="_blank">
                Zobacz szczegóły
            </a>
        </div>

    </div>

</div>