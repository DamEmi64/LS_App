{
  "urls": "https://*:5144",
  "spaProxyEnabled": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.MSSqlServer" ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },

    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "LogContext",

          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 50,
            "period": "0.00:00:05"
          },

          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "HttpMethod",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "HttpUri",
                "DataType": "nvarchar",
                "DataLength": 2048
              },
              {
                "ColumnName": "User",
                "DataType": "nvarchar",
                "DataLength": 256
              }
            ]
          }
        }
      }
    ]
  },
  "config": {
    "autoMigrate": true,
    "usePostgresql": false,
    "frontendUrl": [ "http://localhost:8080", "https://lsfamilia-app.web.app" ],
    "Jwt": {
      "Key": "development-only-change-this-secret-key-before-production",
      "Issuer": "LS API",
      "Audience": "LS Client",
      "ExpiresMinutes": 60,
      "RefreshExpiresDays": 14
    },
    "FirebaseOptions": {
      "ProjectId": "firebase-project"
    },
    "EmailOptions": {
      "SmtpServer": "smtp-server",
      "SmtpPort": 587,
      "PublicKey": "__your_key__",
      "PrivateKey": "__your_key__",
      "ApiEmail": "your_email"
    },
    "EventOptions": {
      "EventLinkTemplate": "https://lsfamilia-app.web.app/events#{0}"
    }
  },
  "version": "1.0.4",
  "AllowedHosts": "*",
  "Admin": {
    "Login": "admin",
    "Password": "admin"
  },
  "ConnectionStrings": {
    "DbContext": "Server=(localdb)\\mssqllocaldb;Database=AppContext;Trusted_Connection=True;MultipleActiveResultSets=true",
    "LogContext": "Server=(localdb)\\mssqllocaldb;Database=AppContext;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
