<Window x:Class="Translations.LoadFromFile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Translations"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="" Height="200" Width="250">
    <Grid>
        <TextBox x:Name="plTb" HorizontalAlignment="Left" Margin="30,12,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="190"/>
        <Label Content="pl" HorizontalAlignment="Left" Margin="10,8,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="enTb" HorizontalAlignment="Left" Margin="30,42,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="190"/>
        <Label Content="en" HorizontalAlignment="Left" Margin="10,38,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="deTb" HorizontalAlignment="Left" Margin="30,80,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="190"/>
        <Label Content="de" HorizontalAlignment="Left" Margin="2,76,0,0" VerticalAlignment="Top" Width="24"/>
        <TextBox x:Name="frTb" HorizontalAlignment="Left" Margin="30,110,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="190"/>
        <Label Content="fr" HorizontalAlignment="Left" Margin="10,106,0,0" VerticalAlignment="Top"/>
        <Button Content="Load" HorizontalAlignment="Left" Margin="30,140,0,0" VerticalAlignment="Top" Width="190" Click="Button_Click"/>

    </Grid>
</Window>
